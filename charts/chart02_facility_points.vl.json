{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive grid map showing where facilities concentrate for one category at a time.",
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "mercator"},
  "params": [
    {
      "name": "facilityChoice",
      "value": "health",
      "bind": {
        "input": "select",
        "name": "Facility category: ",
        "options": ["education", "health", "cultural", "community_sport"],
        "labels": ["Education", "Health", "Cultural", "Community / sport"]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/lga_access.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "fill": "#edf0ec", "stroke": "#87979b", "strokeWidth": 0.65}
    },
    {
      "data": {
        "url": "data/facility_density_grid.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [{"filter": "datum.properties.facility_category === facilityChoice"}],
      "mark": {
        "type": "geoshape",
        "filled": true,
        "opacity": 0.9,
        "stroke": "#fffdf8",
        "strokeWidth": 0.55
      },
      "encoding": {
        "color": {
          "field": "properties.facility_count",
          "type": "quantitative",
          "title": "Facilities in grid cell",
          "scale": {"type": "sqrt", "scheme": "goldorange"},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 170}
        },
        "tooltip": [
          {"field": "properties.facility_count", "type": "quantitative", "title": "Facilities in cell", "format": ",.0f"},
          {"field": "properties.facility_category", "type": "nominal", "title": "Category"}
        ]
      }
    },
    {
      "data": {
        "url": "data/lga_access.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "filled": false, "stroke": "#73888d", "strokeWidth": 0.55}
    }
  ],
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "Segoe UI",
    "legend": {"labelColor": "#334b53", "titleColor": "#152b35"}
  }
}

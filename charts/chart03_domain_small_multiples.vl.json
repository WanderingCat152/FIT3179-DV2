{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Four small-multiple maps using a common 0 to 100 coverage scale.",
  "vconcat": [
    {
      "hconcat": [
        {
          "title": "Health",
          "data": {"url": "data/lga_access.geojson", "format": {"type": "json", "property": "features"}},
          "width": 350,
          "height": 245,
          "projection": {"type": "mercator"},
          "mark": {"type": "geoshape", "stroke": "#f7f5ef", "strokeWidth": 0.6},
          "encoding": {
            "color": {
              "field": "properties.coverage_pct_800m_health",
              "type": "quantitative",
              "title": "Coverage within 800m (%)",
              "scale": {"domain": [0, 100], "scheme": "tealblues"},
              "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 180}
            },
            "tooltip": [
              {"field": "properties.lga_name_2021", "type": "nominal", "title": "LGA"},
              {"field": "properties.coverage_pct_800m_health", "type": "quantitative", "title": "Health coverage", "format": ".1f"}
            ]
          }
        },
        {
          "title": "Education",
          "data": {"url": "data/lga_access.geojson", "format": {"type": "json", "property": "features"}},
          "width": 350,
          "height": 245,
          "projection": {"type": "mercator"},
          "mark": {"type": "geoshape", "stroke": "#f7f5ef", "strokeWidth": 0.6},
          "encoding": {
            "color": {
              "field": "properties.coverage_pct_800m_education",
              "type": "quantitative",
              "scale": {"domain": [0, 100], "scheme": "tealblues"},
              "legend": null
            },
            "tooltip": [
              {"field": "properties.lga_name_2021", "type": "nominal", "title": "LGA"},
              {"field": "properties.coverage_pct_800m_education", "type": "quantitative", "title": "Education coverage", "format": ".1f"}
            ]
          }
        }
      ],
      "resolve": {
        "scale": {"color": "independent"},
        "legend": {"color": "independent"}
      }
    },
    {
      "hconcat": [
        {
          "title": "Cultural",
          "data": {"url": "data/lga_access.geojson", "format": {"type": "json", "property": "features"}},
          "width": 350,
          "height": 245,
          "projection": {"type": "mercator"},
          "mark": {"type": "geoshape", "stroke": "#f7f5ef", "strokeWidth": 0.6},
          "encoding": {
            "color": {
              "field": "properties.coverage_pct_800m_cultural",
              "type": "quantitative",
              "scale": {"domain": [0, 100], "scheme": "tealblues"},
              "legend": null
            },
            "tooltip": [
              {"field": "properties.lga_name_2021", "type": "nominal", "title": "LGA"},
              {"field": "properties.coverage_pct_800m_cultural", "type": "quantitative", "title": "Cultural coverage", "format": ".1f"}
            ]
          }
        },
        {
          "title": "Community / sport",
          "data": {"url": "data/lga_access.geojson", "format": {"type": "json", "property": "features"}},
          "width": 350,
          "height": 245,
          "projection": {"type": "mercator"},
          "mark": {"type": "geoshape", "stroke": "#f7f5ef", "strokeWidth": 0.6},
          "encoding": {
            "color": {
              "field": "properties.coverage_pct_800m_community_sport",
              "type": "quantitative",
              "scale": {"domain": [0, 100], "scheme": "tealblues"},
              "legend": null
            },
            "tooltip": [
              {"field": "properties.lga_name_2021", "type": "nominal", "title": "LGA"},
              {"field": "properties.coverage_pct_800m_community_sport", "type": "quantitative", "title": "Community/sport coverage", "format": ".1f"}
            ]
          }
        }
      ],
      "resolve": {
        "scale": {"color": "independent"},
        "legend": {"color": "independent"}
      }
    }
  ],
  "spacing": 22,
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "Segoe UI",
    "title": {"font": "Segoe UI", "fontSize": 15, "fontWeight": 700, "color": "#152b35"},
    "legend": {"labelColor": "#334b53", "titleColor": "#152b35"}
  }
}

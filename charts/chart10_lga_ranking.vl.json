{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranking of all 31 metropolitan Melbourne local government areas by the project-created overall access score.",
  "data": {"url": "data/lga_access.csv"},
  "transform": [{"calculate": "0", "as": "zero"}],
  "width": "container",
  "height": 640,
  "autosize": {"type": "fit", "contains": "padding"},
  "layer": [
    {
      "mark": {"type": "rule", "stroke": "#a9b7b8", "strokeWidth": 1.8},
      "encoding": {
        "y": {"field": "lga_name_2021", "type": "nominal", "title": null, "sort": {"field": "proximity_access_score_0_100", "order": "descending"}},
        "x": {"field": "zero", "type": "quantitative", "scale": {"domain": [0, 100]}, "title": "Overall access score"},
        "x2": {"field": "proximity_access_score_0_100"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 105, "color": "#2f766f", "stroke": "#fffdf8", "strokeWidth": 1},
      "encoding": {
        "y": {"field": "lga_name_2021", "type": "nominal", "title": null, "sort": {"field": "proximity_access_score_0_100", "order": "descending"}},
        "x": {"field": "proximity_access_score_0_100", "type": "quantitative", "scale": {"domain": [0, 100]}, "title": "Overall access score"},
        "tooltip": [
          {"field": "lga_name_2021", "type": "nominal", "title": "Local government area"},
          {"field": "proximity_access_score_0_100", "type": "quantitative", "title": "Overall access score", "format": ".1f"},
          {"field": "coverage_pct_800m_health", "type": "quantitative", "title": "Health", "format": ".1f"},
          {"field": "coverage_pct_800m_education", "type": "quantitative", "title": "Education", "format": ".1f"},
          {"field": "coverage_pct_800m_cultural", "type": "quantitative", "title": "Cultural", "format": ".1f"},
          {"field": "coverage_pct_800m_community_sport", "type": "quantitative", "title": "Community/sport", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "indexof(['Melbourne', 'Port Phillip', 'Yarra', 'Cardinia', 'Casey', 'Mornington Peninsula'], datum.lga_name_2021) < 0"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 9, "fontSize": 11, "fontWeight": 600, "color": "#334b53"},
      "encoding": {
        "y": {"field": "lga_name_2021", "type": "nominal", "title": null, "sort": {"field": "proximity_access_score_0_100", "order": "descending"}},
        "x": {"field": "proximity_access_score_0_100", "type": "quantitative"},
        "text": {"field": "proximity_access_score_0_100", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "transform": [{"filter": {"field": "lga_name_2021", "oneOf": ["Melbourne", "Port Phillip", "Yarra", "Cardinia", "Casey", "Mornington Peninsula"]}}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 9, "fontSize": 11.5, "fontWeight": 700, "color": "#152b35"},
      "encoding": {
        "y": {"field": "lga_name_2021", "type": "nominal", "title": null, "sort": {"field": "proximity_access_score_0_100", "order": "descending"}},
        "x": {"field": "proximity_access_score_0_100", "type": "quantitative"},
        "text": {"field": "proximity_access_score_0_100", "type": "quantitative", "format": ".1f"}
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Segoe UI",
    "view": {"stroke": null},
    "axis": {"domain": false, "gridColor": "#e1e3de", "labelColor": "#334b53", "labelFontSize": 11, "titleColor": "#152b35"}
  }
}

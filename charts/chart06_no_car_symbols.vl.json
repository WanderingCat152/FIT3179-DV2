{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A map using line length to show the percentage of dwellings without a motor vehicle in each local government area.",
  "width": "container",
  "height": 330,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {"url": "data/lga_access.geojson", "format": {"type": "json", "property": "features"}},
      "mark": {"type": "geoshape", "fill": "#edf1ef", "stroke": "#9aa9a8", "strokeWidth": 0.7},
      "encoding": {
        "tooltip": [{"field": "properties.lga_name_2021", "type": "nominal", "title": "Local government area"}]
      }
    },
    {
      "data": {"url": "data/lga_representative_points.json"},
      "transform": [
        {"calculate": "datum.latitude + datum.pct_dwellings_no_motor_vehicle * 0.005", "as": "spike_latitude"}
      ],
      "mark": {"type": "rule", "color": "#d56f43", "opacity": 0.84, "strokeWidth": 4, "strokeCap": "round"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude2": {"field": "longitude"},
        "latitude2": {"field": "spike_latitude"},
        "order": {"field": "pct_dwellings_no_motor_vehicle", "sort": "descending"},
        "tooltip": [
          {"field": "lga_name_2021", "type": "nominal", "title": "Local government area"},
          {"field": "pct_dwellings_no_motor_vehicle", "type": "quantitative", "title": "No-motor-vehicle dwellings", "format": ".1f"},
          {"field": "proximity_access_score_0_100", "type": "quantitative", "title": "Overall access score", "format": ".1f"},
          {"field": "disadvantage_band", "type": "nominal", "title": "Relative disadvantage group"}
        ]
      }
    },
    {
      "data": {"url": "data/lga_representative_points.json"},
      "mark": {"type": "point", "filled": true, "size": 24, "color": "#9f4d31", "stroke": "#fffdf8", "strokeWidth": 0.8},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    },
    {
      "data": {"url": "data/lga_representative_points.json"},
      "transform": [
        {"filter": {"field": "lga_name_2021", "oneOf": ["Melbourne", "Yarra"]}},
        {"calculate": "datum.latitude + datum.pct_dwellings_no_motor_vehicle * 0.005", "as": "spike_latitude"},
        {"calculate": "datum.lga_name_2021 + ' ' + format(datum.pct_dwellings_no_motor_vehicle, '.1f') + '%'", "as": "spike_label"}
      ],
      "mark": {"type": "text", "align": "left", "baseline": "bottom", "dx": 5, "dy": -3, "fontSize": 10, "fontWeight": 700, "color": "#7b3d2b"},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "spike_latitude", "type": "quantitative"},
        "text": {"field": "spike_label"}
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Segoe UI",
    "view": {"stroke": null},
    "legend": {"labelColor": "#334b53", "titleColor": "#152b35", "titleLimit": 360}
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Population-weighted proximity access score for 31 metropolitan Melbourne LGAs.",
  "data": {
    "url": "data/lga_access.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "width": "container",
  "height": 420,
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {"type": "mercator"},
  "mark": {"type": "geoshape", "stroke": "#f7f5ef", "strokeWidth": 0.8},
  "encoding": {
    "color": {
      "field": "properties.proximity_access_score_0_100",
      "type": "quantitative",
      "title": "Overall access score",
      "scale": {"domain": [0, 100], "scheme": "tealblues"},
      "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 220}
    },
    "tooltip": [
      {"field": "properties.lga_name_2021", "type": "nominal", "title": "LGA"},
      {"field": "properties.proximity_access_score_0_100", "type": "quantitative", "title": "Overall score", "format": ".1f"},
      {"field": "properties.coverage_pct_800m_health", "type": "quantitative", "title": "Health coverage", "format": ".1f"},
      {"field": "properties.coverage_pct_800m_education", "type": "quantitative", "title": "Education coverage", "format": ".1f"},
      {"field": "properties.coverage_pct_800m_cultural", "type": "quantitative", "title": "Cultural coverage", "format": ".1f"},
      {"field": "properties.coverage_pct_800m_community_sport", "type": "quantitative", "title": "Community/sport coverage", "format": ".1f"}
    ]
  },
  "config": {
    "background": null,
    "view": {"stroke": null},
    "font": "Segoe UI",
    "legend": {"labelColor": "#334b53", "titleColor": "#152b35"}
  }
}

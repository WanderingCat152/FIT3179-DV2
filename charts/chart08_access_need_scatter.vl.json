{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot plot comparing overall access across three groups based on the share of dwellings without a motor vehicle.",
  "data": {"url": "data/lga_access.csv"},
  "transform": [
    {"calculate": "datum.irsd_score <= 1018 ? 'Higher disadvantage' : datum.irsd_score <= 1043 ? 'Middle disadvantage' : 'Lower disadvantage'", "as": "disadvantage_class"},
    {
      "window": [{"op": "row_number", "as": "no_car_rank"}],
      "sort": [{"field": "pct_dwellings_no_motor_vehicle", "order": "ascending"}]
    },
    {"calculate": "datum.no_car_rank <= 10 ? 'Lower no-car share' : datum.no_car_rank <= 21 ? 'Middle no-car share' : 'Higher no-car share'", "as": "no_car_group"}
  ],
  "width": "container",
  "height": 380,
  "autosize": {"type": "fit", "contains": "padding"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 125, "opacity": 0.86, "stroke": "#fffdf8", "strokeWidth": 1},
      "encoding": {
        "x": {
          "field": "no_car_group",
          "type": "ordinal",
          "title": "Areas grouped by share of dwellings without a car",
          "sort": ["Lower no-car share", "Middle no-car share", "Higher no-car share"],
          "axis": {"labelAngle": 0, "labelFontSize": 12}
        },
        "xOffset": {"field": "lga_name_2021", "type": "nominal"},
        "y": {
          "field": "proximity_access_score_0_100",
          "type": "quantitative",
          "title": "Overall access score",
          "scale": {"domain": [15, 90]}
        },
        "color": {
          "field": "disadvantage_class",
          "type": "nominal",
          "title": "Relative disadvantage",
          "scale": {
            "domain": ["Higher disadvantage", "Middle disadvantage", "Lower disadvantage"],
            "range": ["#8f365a", "#9b7c8f", "#4f8f88"]
          },
          "legend": {"orient": "bottom", "direction": "horizontal"}
        },
        "tooltip": [
          {"field": "lga_name_2021", "type": "nominal", "title": "Local government area"},
          {"field": "no_car_group", "type": "nominal", "title": "No-car group"},
          {"field": "pct_dwellings_no_motor_vehicle", "type": "quantitative", "title": "No-motor-vehicle dwellings", "format": ".1f"},
          {"field": "proximity_access_score_0_100", "type": "quantitative", "title": "Overall access score", "format": ".1f"},
          {"field": "irsd_score", "type": "quantitative", "title": "IRSD score (lower means greater disadvantage)", "format": ".0f"},
          {"field": "disadvantage_class", "type": "nominal", "title": "Relative disadvantage group"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [{"op": "median", "field": "proximity_access_score_0_100", "as": "median_access"}],
          "groupby": ["no_car_group"]
        }
      ],
      "mark": {"type": "tick", "orient": "horizontal", "size": 62, "thickness": 4, "color": "#152b35"},
      "encoding": {
        "x": {"field": "no_car_group", "type": "ordinal", "sort": ["Lower no-car share", "Middle no-car share", "Higher no-car share"]},
        "y": {"field": "median_access", "type": "quantitative"},
        "tooltip": [
          {"field": "no_car_group", "type": "nominal", "title": "No-car group"},
          {"field": "median_access", "type": "quantitative", "title": "Median access", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": {"field": "lga_name_2021", "oneOf": ["Melbourne", "Brimbank"]}}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 7, "dy": -8, "fontSize": 11, "fontWeight": 700, "color": "#152b35"},
      "encoding": {
        "x": {"field": "no_car_group", "type": "ordinal", "sort": ["Lower no-car share", "Middle no-car share", "Higher no-car share"]},
        "xOffset": {"field": "lga_name_2021", "type": "nominal"},
        "y": {"field": "proximity_access_score_0_100", "type": "quantitative"},
        "text": {"field": "lga_name_2021"}
      }
    }
  ],
  "config": {
    "background": null,
    "font": "Segoe UI",
    "view": {"stroke": null},
    "axis": {"domain": false, "gridColor": "#e1e3de", "labelColor": "#334b53", "titleColor": "#152b35"},
    "legend": {"labelColor": "#334b53", "titleColor": "#152b35"}
  }
}
